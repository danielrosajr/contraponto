        },
        {
          "id": "node_096d0e5a-6a0f-4635-8ccb-e90aa0bfef7c",
          "type": "premissa",
          "title": "Sofrimento consciente",
          "content": "Se desconheço um acontecimento, não posso sofrer conscientemente por ele naquele instante.",
          "voiceId": "eu1",
          "x": 360,
          "y": -160,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T05:21:31.434Z",
          "updatedAt": "2026-10-23T05:21:31.434Z"
        },
        {
          "id": "node_0d602bd5-fd0a-42a7-bc30-1e043b8c9d9b",
          "type": "objecao",
          "title": "E as consequências?",
          "content": "Não perceber algo elimina as consequências que isso pode produzir na minha vida?",
          "voiceId": "eu2",
          "x": 720,
          "y": -210,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T05:21:31.434Z",
          "updatedAt": "2026-10-23T05:21:31.434Z",
          "discussion": [
            {
              "id": "mark_d6136e00-52df-4ccb-9980-518eb88dada7",
              "key": "conversar",
              "label": "Quero conversar sobre isso",
              "note": "Como diferenciar sofrimento emocional e consequências?",
              "createdAt": "2026-10-23T05:21:31.434Z"
            }
          ]
        },
        {
          "id": "node_5e21d4d7-0f1a-4a10-889d-3631fa3efef0",
          "type": "contra",
          "title": "Duas dimensões",
          "content": "Ausência de sofrimento imediato não significa ausência de efeitos concretos.",
          "voiceId": "eu1",
          "x": 1080,
          "y": -230,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T05:21:31.434Z",
          "updatedAt": "2026-10-23T05:21:31.434Z"
        },
        {
          "id": "node_2cdc42df-d6d6-4c79-b161-cbdcf210ad52",
          "type": "cenario",
          "title": "Cenário A",
          "content": "Uma pessoa esconde um fato sem alterar em nada minhas decisões ou meu cotidiano.",
          "voiceId": "eu1",
          "x": 720,
          "y": 65,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T05:21:31.434Z",
          "updatedAt": "2026-10-23T05:21:31.434Z"
        },
        {
          "id": "node_6f16b357-ce16-4523-bed0-7e377fcafa8f",
          "type": "cenario",
          "title": "Cenário B",
          "content": "Uma informação omitida me impede de fazer escolhas importantes.",
          "voiceId": "eu2",
          "x": 1080,
          "y": 85,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T05:21:31.434Z",
