          "id": "node_c6c402ae-cd49-4f75-bcf1-007aca317df2",
          "type": "pergunta",
          "title": "Pergunta principal",
          "content": "O que significa dizer que algo não me afeta se eu desconheço sua existência?",
          "notes": "",
          "classification": "",
          "state": "ativo",
          "voiceId": "eu1",
          "x": 0,
          "y": 0,
