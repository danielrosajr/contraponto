        },
        {
          "id": "node_5b7df702-520e-4809-a19f-9f1f40d08dfe",
          "type": "pergunta",
          "title": "O que é ser afetado?",
          "content": "Estou falando de sentir algo, de perder autonomia ou de sofrer consequências?",
          "voiceId": "observador",
          "x": 1440,
          "y": -115,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T05:21:31.434Z",
          "updatedAt": "2026-10-23T05:21:31.434Z"
        },
        {
          "id": "node_cb574cd6-8c97-496f-b5af-8a6fdb5935ce",
          "type": "valor",
          "title": "Autonomia",
          "content": "Valorizar a possibilidade de escolher com base em informações relevantes.",
          "voiceId": "eu1",
          "x": 1440,
          "y": 180,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T05:21:31.434Z",
