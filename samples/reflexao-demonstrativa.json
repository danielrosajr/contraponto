        },
        {
          "id": "node_8005028b-3866-4c1f-8127-ef26de8cde66",
          "type": "premissa",
          "title": "Sofrimento consciente",
          "content": "Se desconheço um acontecimento, não posso sofrer conscientemente por ele naquele instante.",
          "voiceId": "eu1",
          "x": 360,
          "y": -160,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.422Z",
          "updatedAt": "2026-10-23T03:54:39.422Z"
        },
        {
          "id": "node_bd0de695-c2dc-4aed-b136-2385c187311a",
          "type": "objecao",
          "title": "E as consequências?",
          "content": "Não perceber algo elimina as consequências que isso pode produzir na minha vida?",
          "voiceId": "eu2",
          "x": 720,
          "y": -210,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.422Z",
          "updatedAt": "2026-10-23T03:54:39.422Z",
          "discussion": [
            {
              "id": "mark_4e564b38-be17-4dae-a2da-aaecd3454e90",
              "key": "conversar",
              "label": "Quero conversar sobre isso",
              "note": "Como diferenciar sofrimento emocional e consequências?",
              "createdAt": "2026-10-23T03:54:39.422Z"
            }
          ]
        },
        {
          "id": "node_21fd57c4-0288-41c8-9c13-10f036e37fce",
          "type": "contra",
          "title": "Duas dimensões",
          "content": "Ausência de sofrimento imediato não significa ausência de efeitos concretos.",
          "voiceId": "eu1",
          "x": 1080,
          "y": -230,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.422Z",
          "updatedAt": "2026-10-23T03:54:39.422Z"
        },
        {
          "id": "node_61219fe5-e126-4a79-b875-381b88156651",
          "type": "cenario",
          "title": "Cenário A",
          "content": "Uma pessoa esconde um fato sem alterar em nada minhas decisões ou meu cotidiano.",
          "voiceId": "eu1",
          "x": 720,
          "y": 65,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.422Z",
          "updatedAt": "2026-10-23T03:54:39.422Z"
        },
        {
          "id": "node_f840299a-9686-4147-a521-2a566d8408e1",
          "type": "cenario",
          "title": "Cenário B",
          "content": "Uma informação omitida me impede de fazer escolhas importantes.",
          "voiceId": "eu2",
          "x": 1080,
          "y": 85,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.422Z",
          "updatedAt": "2026-10-23T03:54:39.422Z"
        },
        {
          "id": "node_b79b9703-3379-46db-88d9-acd204c880d0",
          "type": "pergunta",
          "title": "O que é ser afetado?",
          "content": "Estou falando de sentir algo, de perder autonomia ou de sofrer consequências?",
          "voiceId": "observador",
          "x": 1440,
          "y": -115,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.422Z",
          "updatedAt": "2026-10-23T03:54:39.422Z"
        },
        {
          "id": "node_0f3c411f-eead-4e32-8947-e24d033de770",
          "type": "valor",
          "title": "Autonomia",
          "content": "Valorizar a possibilidade de escolher com base em informações relevantes.",
          "voiceId": "eu1",
          "x": 1440,
          "y": 180,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.422Z",
          "updatedAt": "2026-10-23T03:54:39.422Z"
        },
        {
          "id": "node_5f310749-3602-4450-8639-a6ca5a2d7c6e",
          "type": "retorno",
          "title": "Voltar ao centro",
          "content": "Agora volto à pergunta original, distinguindo o que sinto do que realmente acontece.",
          "voiceId": "observador",
          "x": 1800,
          "y": -35,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.422Z",
          "updatedAt": "2026-10-23T03:54:39.422Z"
        },
        {
          "id": "node_e1aae75d-355b-446b-9fdc-052c2c616262",
          "type": "provisoria",
          "title": "Conclusão provisória",
          "content": "Não saber pode impedir sofrimento consciente imediato, mas não garante ausência de consequências, nem preserva necessariamente minha autonomia.",
          "voiceId": "eu1",
          "x": 2160,
          "y": -45,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.422Z",
          "updatedAt": "2026-10-23T03:54:39.422Z"
        },
        {
          "id": "node_f3dd1954-e8b1-4c74-b9b2-1efcf626cb90",
          "type": "roteiro",
          "title": "Organizando o exercício",
          "content": "Quero comparar o que sinto, o que acontece e o que considero justo em cada cenário.",
          "voiceId": "observador",
          "x": 325,
          "y": 420,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
