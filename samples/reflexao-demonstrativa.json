    },
    {
      "id": "node_5f2a6d27-572b-4916-a320-574acd1752f4",
      "type": "premissa",
      "title": "Sofrimento consciente",
      "content": "Se desconheço um acontecimento, não posso sofrer conscientemente por ele naquele instante.",
      "voiceId": "eu1",
      "x": 360,
      "y": -160,
      "notes": "",
      "classification": "hipotese",
      "state": "ativo",
      "collapsed": false,
      "createdAt": "2026-10-22T21:26:55.630Z",
      "updatedAt": "2026-10-22T21:26:55.630Z"
    },
    {
      "id": "node_4a67fd4c-46c8-4e04-a7ce-6bdbb2bc7076",
      "type": "objecao",
      "title": "E as consequências?",
      "content": "Não perceber algo elimina as consequências que isso pode produzir na minha vida?",
      "voiceId": "eu2",
      "x": 720,
      "y": -210,
      "notes": "",
      "classification": "hipotese",
      "state": "ativo",
      "collapsed": false,
      "createdAt": "2026-10-22T21:26:55.630Z",
      "updatedAt": "2026-10-22T21:26:55.630Z"
    },
    {
      "id": "node_042e66f0-8315-4e39-8117-1d697816d555",
      "type": "contra",
      "title": "Duas dimensões",
      "content": "Ausência de sofrimento imediato não significa ausência de efeitos concretos.",
      "voiceId": "eu1",
      "x": 1080,
      "y": -230,
      "notes": "",
      "classification": "hipotese",
      "state": "ativo",
      "collapsed": false,
      "createdAt": "2026-10-22T21:26:55.630Z",
      "updatedAt": "2026-10-22T21:26:55.630Z"
    },
    {
      "id": "node_53e815bb-ff00-4c6b-8033-85daad8907e2",
      "type": "cenario",
      "title": "Cenário A",
      "content": "Uma pessoa esconde um fato sem alterar em nada minhas decisões ou meu cotidiano.",
      "voiceId": "eu1",
      "x": 720,
      "y": 65,
      "notes": "",
      "classification": "hipotese",
      "state": "ativo",
      "collapsed": false,
      "createdAt": "2026-10-22T21:26:55.630Z",
      "updatedAt": "2026-10-22T21:26:55.630Z"
    },
    {
      "id": "node_a13e92a6-a5a7-4d21-8862-41e608845c1b",
      "type": "cenario",
      "title": "Cenário B",
      "content": "Uma informação omitida me impede de fazer escolhas importantes.",
      "voiceId": "eu2",
      "x": 1080,
      "y": 85,
      "notes": "",
      "classification": "hipotese",
      "state": "ativo",
      "collapsed": false,
