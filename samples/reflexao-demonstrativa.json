          "fallacies": []
        },
        {
          "id": "node_28b3f1f8-2fa5-4820-9528-134059c5dd26",
          "type": "comentario",
          "title": "Pensamento solto",
          "content": "Ainda não sei se este exemplo realmente ajuda. Vou deixá-lo registrado.",
          "voiceId": "eu1",
          "x": 700,
          "y": 440,
          "notes": "",
          "classification": "hipotese",
