    },
    {
      "id": "node_6d54ef7a-3381-4892-aefe-d33da3245bd1",
      "type": "retorno",
      "title": "Voltar ao centro",
      "content": "Agora volto à pergunta original, distinguindo o que sinto do que realmente acontece.",
      "voiceId": "observador",
      "x": 1800,
      "y": -35,
      "notes": "",
      "classification": "hipotese",
      "state": "ativo",
