      "updatedAt": "2026-10-22T21:26:55.630Z"
    },
    {
      "id": "node_8d65f33e-4a8b-409b-9a5a-bb3d411d364f",
      "type": "valor",
      "title": "Autonomia",
      "content": "Valorizar a possibilidade de escolher com base em informações relevantes.",
      "voiceId": "eu1",
      "x": 1440,
      "y": 180,
      "notes": "",
