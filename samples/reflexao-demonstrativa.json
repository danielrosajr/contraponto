      "nodes": [
        {
          "id": "node_c2d8796f-d8c7-4a48-83f3-7fceeda0c425",
          "type": "pergunta",
          "title": "Pergunta principal",
          "content": "O que significa dizer que algo não me afeta se eu desconheço sua existência?",
          "notes": "",
          "classification": "",
          "state": "ativo",
          "voiceId": "eu1",
          "x": 0,
          "y": 0,
          "collapsed": false,
          "createdAt": "2026-10-23T03:54:39.420Z",
