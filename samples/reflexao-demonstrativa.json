      "nodes": [
        {
          "id": "node_8d3733ac-83e9-47c9-bea2-7eae4c9d9667",
          "type": "pergunta",
          "title": "Pergunta principal",
          "content": "O que significa dizer que algo não me afeta se eu desconheço sua existência?",
          "notes": "",
          "classification": "",
          "state": "ativo",
          "voiceId": "eu1",
          "x": 0,
          "y": 0,
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.259Z",
          "updatedAt": "2026-10-22T22:54:19.259Z",
          "fallacies": []
        },
        {
          "id": "node_f6e4cf08-6c1c-49eb-bef5-dae37ee83824",
          "type": "premissa",
          "title": "Sofrimento consciente",
          "content": "Se desconheço um acontecimento, não posso sofrer conscientemente por ele naquele instante.",
          "voiceId": "eu1",
          "x": 360,
          "y": -160,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
          "updatedAt": "2026-10-22T22:54:19.261Z",
          "fallacies": []
        },
        {
          "id": "node_596174df-7c90-4c64-ba4e-4066d27b6927",
          "type": "objecao",
          "title": "E as consequências?",
          "content": "Não perceber algo elimina as consequências que isso pode produzir na minha vida?",
          "voiceId": "eu2",
          "x": 720,
          "y": -210,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
          "updatedAt": "2026-10-22T22:54:19.261Z",
          "fallacies": []
        },
        {
          "id": "node_67440740-c1bf-445c-a09b-df5d6bdbb91b",
          "type": "contra",
          "title": "Duas dimensões",
          "content": "Ausência de sofrimento imediato não significa ausência de efeitos concretos.",
          "voiceId": "eu1",
          "x": 1080,
          "y": -230,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
          "updatedAt": "2026-10-22T22:54:19.261Z",
          "fallacies": []
        },
        {
          "id": "node_bbb8c1f8-1897-40fd-964a-69ae8660cd77",
          "type": "cenario",
          "title": "Cenário A",
          "content": "Uma pessoa esconde um fato sem alterar em nada minhas decisões ou meu cotidiano.",
          "voiceId": "eu1",
          "x": 720,
          "y": 65,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
          "updatedAt": "2026-10-22T22:54:19.261Z",
          "fallacies": []
        },
        {
          "id": "node_b5c353d8-ec81-4c3c-92c7-f819bd333471",
          "type": "cenario",
          "title": "Cenário B",
          "content": "Uma informação omitida me impede de fazer escolhas importantes.",
          "voiceId": "eu2",
          "x": 1080,
          "y": 85,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
          "updatedAt": "2026-10-22T22:54:19.261Z",
          "fallacies": []
        },
        {
          "id": "node_a61ce614-52a2-41c4-8a12-6935a52d5c20",
          "type": "pergunta",
          "title": "O que é ser afetado?",
          "content": "Estou falando de sentir algo, de perder autonomia ou de sofrer consequências?",
          "voiceId": "observador",
          "x": 1440,
          "y": -115,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
          "updatedAt": "2026-10-22T22:54:19.261Z",
          "fallacies": []
        },
        {
          "id": "node_406955e5-7d17-42c0-a3e4-23e703497a39",
          "type": "valor",
          "title": "Autonomia",
          "content": "Valorizar a possibilidade de escolher com base em informações relevantes.",
          "voiceId": "eu1",
          "x": 1440,
          "y": 180,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
          "updatedAt": "2026-10-22T22:54:19.261Z",
          "fallacies": []
        },
        {
          "id": "node_6f4336a4-dc29-41d8-aa0b-ee7567b8863f",
          "type": "retorno",
          "title": "Voltar ao centro",
          "content": "Agora volto à pergunta original, distinguindo o que sinto do que realmente acontece.",
          "voiceId": "observador",
          "x": 1800,
          "y": -35,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
          "updatedAt": "2026-10-22T22:54:19.261Z",
          "fallacies": []
        },
        {
          "id": "node_d382d759-9d67-4b67-92dd-c848082ec336",
          "type": "provisoria",
          "title": "Conclusão provisória",
          "content": "Não saber pode impedir sofrimento consciente imediato, mas não garante ausência de consequências, nem preserva necessariamente minha autonomia.",
          "voiceId": "eu1",
          "x": 2160,
          "y": -45,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
          "updatedAt": "2026-10-22T22:54:19.261Z",
          "fallacies": []
        },
        {
          "id": "node_13ba57fc-fc3a-4fcf-bc6d-82f47001b9d7",
          "type": "roteiro",
          "title": "Organizando o exercício",
          "content": "Quero comparar o que sinto, o que acontece e o que considero justo em cada cenário.",
          "voiceId": "observador",
          "x": 325,
          "y": 420,
          "notes": "",
          "classification": "hipotese",
          "state": "ativo",
          "collapsed": false,
          "createdAt": "2026-10-22T22:54:19.261Z",
