  "nodes": [
    {
      "id": "node_4bb63691-09cc-424c-a9c8-760bbc0127d2",
      "type": "pergunta",
      "title": "Pergunta principal",
      "content": "O que significa dizer que algo não me afeta se eu desconheço sua existência?",
      "notes": "",
      "classification": "",
      "state": "ativo",
      "voiceId": "eu1",
      "x": 0,
      "y": 0,
      "collapsed": false,
